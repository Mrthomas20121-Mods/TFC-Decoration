{
  "multipart": [
    {
      "apply": {
        "model": "tfc_decoration:block/wattle/terracotta_magenta"
      }
    },
    {
      "apply": {
        "model": "tfc:block/wattle/top"
      },
      "when": {
        "top": "true"
      }
    },
    {
      "apply": {
        "model": "tfc:block/wattle/bottom"
      },
      "when": {
        "bottom": "true"
      }
    },
    {
      "apply": {
        "model": "tfc:block/wattle/left"
      },
      "when": {
        "left": "true"
      }
    },
    {
      "apply": {
        "model": "tfc:block/wattle/right"
      },
      "when": {
        "right": "true"
      }
    }
  ]
}